<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime of the app and of the Node binary it starts (ADR
  desktop-app-tauri-shell-over-the-node-standalone-server). V8 compiles JavaScript at
  run time: Node needs JIT and writable-executable memory. The native addons
  (better-sqlite3, argon2, ssh2) are signed with the app's own identity, so library
  validation stays on.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
