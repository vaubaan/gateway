{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaubaan",
  "version": "0.0.0",
  "identifier": "com.vaubaan.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "Copyright the Vaubaan authors. Apache-2.0.",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "resources/gateway/": "gateway/",
      "resources/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://vaubaan.com/desktop/latest.json"],
      "requireSignedVersion": true
    }
  }
}
