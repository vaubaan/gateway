# Paths Semgrep does not scan (scripts/sast.sh, CI job `sast`). A file here
# replaces Semgrep's defaults, so the generated and vendored trees are listed too.
node_modules/
.next/
dist/
out/
coverage/
test-results/
playwright-report/

# The test cases of the custom rules (run by `semgrep --test`, not scanned).
.semgrep/

# Tests and fixtures are not scanned: they hold fake secrets and call what
# production code must not (child_process, ciphers); they never ship.
apps/*/tests/
packages/*/tests/
plugins/*/tests/
*.test.ts
*.test.tsx
*.test.mjs

# Documentation and the legacy v4 tree are not code that ships.
docs/
*.md

# The community rules checked out by the CI job `sast`.
.semgrep-rules/
