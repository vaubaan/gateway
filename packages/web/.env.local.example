# =============================================================================
# @vaubaan/web — env vars for local dev (`packages/web/.env.local`)
# =============================================================================
# Copy this file to `.env.local` and fill the values. NEVER commit `.env.local`.
#
# This file is the Next.js runtime env. It MUST be a 1-to-1 mirror of what's
# configured on Vercel for production (see `vercel env ls production`).
#
# Hard rule : ONLY scoped credentials live here.
#   - SUPABASE_SERVICE_ROLE_KEY  → scoped to a single Supabase project.
#   - GITHUB_APP_PRIVATE_KEY     → scoped to App installations only.
# Never put `SUPABASE_MGMT_TOKEN` or a user-wide GitHub PAT in this file —
# those are operator-only and live in `/.env` at the repo root.
# =============================================================================

# Supabase — project URL, anon key, service-role key.
# Fetch the current values via `vercel env pull` (mirror prod) or directly
# from the Supabase dashboard of your Core project. Project ref is intentionally
# NOT hardcoded here — single source of truth is the Vercel project env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub App "Vaubaan Gateway" — provider-connect flow (NOT the SSO OAuth App).
# Register at https://github.com/organizations/sbw-vaubaan/settings/apps/new
# Setup URL must be `https://vaubaan.com/api/integrations/github/callback`.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=vaubaan-gateway
# Multi-line PEM. Both PKCS#1 (`BEGIN RSA PRIVATE KEY`) and PKCS#8
# (`BEGIN PRIVATE KEY`) are accepted — GitHub downloads as PKCS#1 by default.
# In Vercel project env, paste the multi-line value as-is (Vercel handles it).
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIE...
-----END RSA PRIVATE KEY-----"

# Vercel OAuth Integration "Vaubaan".
# Register at https://vercel.com/integrations/console/.
# Redirect URL : https://vaubaan.com/api/integrations/vercel/callback
# Slug is the integration's URL slug (visible in the marketplace path).
VERCEL_INTEGRATION_SLUG=vaubaan
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=

# Supabase OAuth Mgmt API client.
# Register at https://supabase.com/dashboard/org/<your-org>/oauth-apps.
# Redirect URL : https://vaubaan.com/api/integrations/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# Optional — Upstash Redis for hot-path context cache.
# If unset, falls back to per-process MemoryCacheClient.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
