# =============================================================================
# @vauban/web — env vars for local dev (`packages/web/.env.local`)
#
# Copy this file to `.env.local` and fill the values. NEVER commit `.env.local`.
# =============================================================================

# Supabase (project URL, anon key, service_role key)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub App "Vauban Gateway"
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=vauban-gateway
# Multiline PEM — replace newlines with \n when storing on Vercel.
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Optional — Upstash Redis for hot-path context cache.
# If unset, falls back to per-process MemoryCacheClient.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
