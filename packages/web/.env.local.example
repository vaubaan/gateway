# =============================================================================
# packages/web — Next.js runtime env vars
# =============================================================================
# Copy to `.env.local` for local dev. NEVER commit a populated copy.
# In prod, these are configured on Vercel project env vars (cf. infra block
# in .claude/build-plans/init.json).
# =============================================================================

# Public Supabase config (exposed to the browser — anon key, RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key (NEVER expose to the browser).
# Used by route handlers and server actions for admin operations.
# In v1, used sparingly: most reads go through the user's session with RLS.
SUPABASE_SERVICE_ROLE_KEY=
