{
  "name": "@crm/core",
  "version": "0.0.0",
  "private": true,
  "description": "Placeholder for shared CRM business logic (zk crypto helpers, recipient list computation, audit log writers). Empty in v1 init — filled by later phases.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./crypto": {
      "types": "./src/crypto/index.ts",
      "import": "./src/crypto/index.ts"
    },
    "./secret-manager": {
      "types": "./src/secret-manager/index.ts",
      "import": "./src/secret-manager/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.7.16"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "0.7.8"
  }
}
