{
  "name": "@vaubaan/gateway",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.0",
  "description": "Vaubaan Gateway v5 — open source, on-prem MCP gateway that gives coding agents risk-budgeted missions instead of cloud credentials",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "type-check": "npm run --workspaces --if-present type-check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real-clouds": "playwright test --project=e2e-real-clouds",
    "dev": "npm run --workspace @vaubaan/gateway-app dev",
    "prepare": "husky || true",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "@types/node": "20.19.41",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.8.3",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@sbw-vaubaan/harness": "1.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{md,json,yaml,yml,css,html}": [
      "prettier --check"
    ]
  }
}
