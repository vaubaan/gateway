{
  "name": "@vaubaan/gateway",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.25",
  "description": "Vaubaan Gateway v5 — open source, on-prem MCP gateway that gives coding agents risk-budgeted missions instead of cloud credentials",
  "license": "Apache-2.0",
  "homepage": "https://vaubaan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaubaan/gateway.git"
  },
  "bugs": {
    "url": "https://github.com/vaubaan/gateway/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "coding-agents",
    "ai-agents",
    "on-prem",
    "self-hosted",
    "security",
    "least-privilege",
    "audit"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "type-check": "node scripts/type-check.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0 --cache --cache-location .cache/eslint/ --cache-strategy content",
    "lint:fix": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier --cache-strategy content",
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run --project shared --no-isolate && vitest run --project isolated",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:v5",
    "test:e2e:v5": "npm run build --workspace @vaubaan/gateway-app && playwright test -c apps/gateway/tests/e2e/v5/playwright.config.ts",
    "dev": "npm run --workspace @vaubaan/gateway-app dev",
    "demo": "tsx apps/gateway/tests/demo/main.ts",
    "prepare": "husky || true",
    "gen-master-key": "node scripts/gen-master-key.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t vaubaan-gateway:local .",
    "docker:smoke": "deploy/docker/smoke.sh vaubaan-gateway:local",
    "ci": "npm run type-check && npm run lint && npm run format:check && VAUBAAN_BUILD_TYPECHECKED=1 npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sigstore/tuf": "5.0.1",
    "@types/node": "26.6.6",
    "@vaubaan/harness": "^2.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{md,json,yaml,yml,css,html}": [
      "prettier --check"
    ]
  },
  "harness": {
    "lint": {
      "ignore": [
        "apps/website/public/**"
      ]
    }
  }
}
