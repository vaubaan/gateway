# TLS termination in front of the gateway (spec §6 "transport").
# GATEWAY_DOMAIN is the only variable this container receives: compose.yaml
# interpolates it from deploy/config/.env (`docker compose --env-file`).
{$GATEWAY_DOMAIN} {
	# Compression for the static assets only (security audit 2026-10-31, L10): a
	# page that shows a secret once (a mission token) beside text an attacker
	# influences must not be compressed, or its size could reveal the secret
	# (BREACH). The static assets hold no secret.
	@static path /_next/static/*
	encode @static zstd gzip

	# No security header here: the gateway sets them itself on every response
	# (HSTS, the Content-Security-Policy with its per-request nonce, framing,
	# nosniff, referrer and permissions policies), so that every deployment has
	# them whatever its proxy. A header set here too would be sent twice, and two
	# policies are enforced together (docs/handbook/configuration.md).

	reverse_proxy gateway:3000 {
		# Do not buffer streamed MCP responses (SSE frames).
		flush_interval -1
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
