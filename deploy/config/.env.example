# Vaubaan Gateway — environment variables (spec §4.3).
#
# Copy to deploy/config/.env (gitignored) and fill in. Every VAUBAAN_* key has
# a twin in gateway.example.yaml; when both are set, the file wins (every key
# of the example YAML is commented out, so this file decides until you
# uncomment one there). Secrets accept a *_FILE sibling holding a path
# (Docker / Kubernetes secrets).
# Listener: the standalone server reads PORT (3000) and HOSTNAME (0.0.0.0).

# --- Reverse proxy (deploy/compose.yaml, deploy/caddy/Caddyfile) ------------
# Host name of the instance; Caddy obtains the TLS certificate for it. Must be
# the host of VAUBAAN_PUBLIC_URL below (nothing checks it for you). It is the
# only variable of this file the proxy container receives.
GATEWAY_DOMAIN=gateway.example.com

# --- Instance ----------------------------------------------------------------
# Optional: mount a YAML file and name it here (compose.yaml does).
# VAUBAAN_CONFIG_FILE=/config/gateway.yaml

# REQUIRED. Public https origin of the instance.
VAUBAAN_PUBLIC_URL=https://gateway.example.com

# Proxies trusted for X-Forwarded-For (IPs or CIDR, comma-separated). Default: none.
# 172.16.0.0/12 covers Docker's default address pool, i.e. the Caddy container of compose.yaml.
VAUBAAN_TRUSTED_PROXIES=172.16.0.0/12

# REQUIRED. SQLite file on a persistent volume. compose.yaml sets this same
# value itself (it owns the /data volume) and overrides the line below.
VAUBAAN_STORE_PATH=/data/gateway.db

# --- Encryption at rest -----------------------------------------------------
# REQUIRED. `npm run gen-master-key` (32 bytes, base64). Or VAUBAAN_MASTER_KEY_FILE=/run/secrets/...
VAUBAAN_MASTER_KEY=
# VAUBAAN_MASTER_KEY_VERSION=1
# VAUBAAN_MASTER_KEY_PREVIOUS=1=<base64>,2=<base64>

# --- Sign-in providers ------------------------------------------------------
# Optional: providers can also be added in Settings → Sign-in. Several may be set.
# One OpenID Connect provider through the VAUBAAN_IDP_* keys (the provider `idp`,
# callback <public_url>/auth/callback); issuer, client id and secret all required.
# VAUBAAN_IDP_ISSUER=https://login.example.com/realms/acme
# VAUBAAN_IDP_CLIENT_ID=vaubaan-gateway
# VAUBAAN_IDP_CLIENT_SECRET=            # or VAUBAAN_IDP_CLIENT_SECRET_FILE
# VAUBAAN_IDP_CLAIM_SUB=sub
# VAUBAAN_IDP_CLAIM_EMAIL=email
# VAUBAAN_IDP_CLAIM_GROUPS=groups
# Admission: allowed email domains (invited addresses are admitted besides them),
# or invited addresses only. Neither: everyone the directory signs in — refused for
# a provider where anyone can open an account (personal Google or Microsoft).
# VAUBAAN_IDP_ALLOWED_EMAIL_DOMAINS=example.com
# VAUBAAN_IDP_INVITATION_ONLY=false
#
# Any number of providers as VAUBAAN_SIGN_IN_<ID>_<FIELD> (a hyphen of the id
# becomes an underscore; callback <public_url>/auth/callback/<id>). FIELD is one of
# KIND (oidc | github), NAME, ISSUER, CLIENT_ID, CLIENT_SECRET (or _FILE),
# CLAIM_SUB, CLAIM_EMAIL, CLAIM_GROUPS, ALLOWED_EMAIL_DOMAINS, INVITATION_ONLY.
# GitHub (an OAuth App; ISSUER only for a GitHub Enterprise Server). Anyone can
# hold a GitHub account: set allowed domains or invitation only.
# VAUBAAN_SIGN_IN_GITHUB_KIND=github
# VAUBAAN_SIGN_IN_GITHUB_CLIENT_ID=Ov23liExample
# VAUBAAN_SIGN_IN_GITHUB_CLIENT_SECRET=  # or VAUBAAN_SIGN_IN_GITHUB_CLIENT_SECRET_FILE
# VAUBAAN_SIGN_IN_GITHUB_INVITATION_ONLY=true

# --- Admin rule (REQUIRED: group and/or emails) -----------------------------
# A group names its provider: <provider-id>:<group> (a GitHub group is a team,
# org/team). A bare group name is accepted while one provider is configured.
# Emails match the verified address of a user of any provider, and are always
# admitted to sign in.
# VAUBAAN_ADMIN_GROUP=idp:gateway-admins
VAUBAAN_ADMIN_EMAILS=ops@example.com

# --- Provider apps: VAUBAAN_PROVIDER_<ID>_<FIELD> ---------------------------
# Only for providers connected through an app (an App installation or an
# OAuth client); API-key and SSH providers need nothing here.
# FIELD is one of CLIENT_ID, CLIENT_SECRET, APP_ID, APP_SLUG, PRIVATE_KEY;
# secrets accept _FILE. Hyphens in the plugin id become underscores.
# VAUBAAN_PROVIDER_GITHUB_APP_ID=12345
# VAUBAAN_PROVIDER_GITHUB_APP_SLUG=acme-gateway
# VAUBAAN_PROVIDER_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github_app_key.pem
# VAUBAAN_PROVIDER_GITHUB_CLIENT_ID=Iv1.0123456789abcdef
# VAUBAAN_PROVIDER_GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_app_client_secret
# VAUBAAN_PROVIDER_SUPABASE_CLIENT_ID=
# VAUBAAN_PROVIDER_SUPABASE_CLIENT_SECRET=
# VAUBAAN_PROVIDER_RAILWAY_CLIENT_ID=
# VAUBAAN_PROVIDER_RAILWAY_CLIENT_SECRET=

# --- Bootstrap (REQUIRED while the configuration sets no sign-in provider) --
# At least 32 characters, e.g. `openssl rand -hex 24`. Or VAUBAAN_BOOTSTRAP_TOKEN_FILE.
# Opens /admin/bootstrap only. Revoked automatically (stored in the database)
# after the first operator signs in through the IdP; harmless to leave set.
VAUBAAN_BOOTSTRAP_TOKEN=

# --- Telemetry (spec §9), retention, delays, logging -----------------------
# Telemetry is off by default. Leave VAUBAAN_TELEMETRY_ENABLED unset to let an
# operator decide on Administration → Telemetry; setting it (true or false)
# decides here and makes that page read-only. The built-in collector URL is a
# placeholder the gateway never sends to (deploy/collector/README.md).
# VAUBAAN_TELEMETRY_ENABLED=false
# VAUBAAN_TELEMETRY_COLLECTOR_URL=https://collector.example.net/rest/v1/plugin_reports?apikey=<public key>
# Retention days and the MCP rate limit are integers >= 1; delays are durations
# (a whole number > 0 and one unit: 30s, 10m, 24h, 7d). VAUBAAN_REQUEST_EXPIRY is
# how long a claim or an approval request stays answerable, VAUBAAN_APPROVAL_EXPIRY
# how long a granted approval stays usable.
# VAUBAAN_RETENTION_DAYS=90
# VAUBAAN_REQUEST_EXPIRY=24h
# VAUBAAN_APPROVAL_EXPIRY=10m
# VAUBAAN_MCP_RATE_LIMIT_PER_MINUTE=600
# VAUBAAN_LOG_LEVEL=info

# --- Git remote (spec §4.1 bis) ----------------------------------------------
# The largest push accepted, in MiB (1 to 4096), and how long one git request
# may last (at most 1h). Behind Railway: keep it under 15m, and know that a
# request body must finish uploading within 5 minutes there.
# VAUBAAN_GIT_MAX_PACK_MB=200
# VAUBAAN_GIT_REQUEST_TIMEOUT=10m

# --- Management door: OAuth authorization server (spec §4.1 bis) ------------
# Delegated access token lifetime (at most 1h) and refresh token lifetime (longer than the access token's).
# VAUBAAN_OAUTH_ACCESS_TOKEN_TTL=15m
# VAUBAAN_OAUTH_REFRESH_TOKEN_TTL=30d
# Absolute lifetime of a delegation, from the user's consent: past it the client
# must ask for the consent again, however recently it renewed.
# VAUBAAN_OAUTH_DELEGATION_MAX_LIFETIME=90d
# Seconds during which the refresh token just rotated may be presented once more
# (two sessions renewing together); 0 disables, at most 60.
# VAUBAAN_OAUTH_REFRESH_REUSE_WINDOW_SECONDS=30
# Who may become an OAuth client: open | operator-approved | closed.
# VAUBAAN_OAUTH_CLIENT_REGISTRATION_POLICY=operator-approved
# Under operator-approved: loopback-only clients (CLI agents) need no approval.
# VAUBAAN_OAUTH_CLIENT_REGISTRATION_AUTO_APPROVE_LOOPBACK=true
# Accept Client ID Metadata Documents (the instance then fetches them over https).
# VAUBAAN_OAUTH_CLIENT_REGISTRATION_METADATA_DOCUMENTS=false
