# =============================================================================
# cloud-resource-manager — root .env.example (operator-side, not committed)
# =============================================================================
# This file lists the operator-side tokens required to run management/CI
# tasks against the Cloud Resource Manager infra. The runtime secrets used
# by the Next.js web app live in packages/web/.env.local (see
# packages/web/.env.local.example).
#
# Copy this file to `.env`, fill the values, and never commit `.env`.
# =============================================================================

# Supabase Management API PAT — user-wide scope. Used by:
#  - the @supabase MCP server (.mcp.json)
#  - CI/ops scripts that need the management API
SUPABASE_MGMT_TOKEN=

# Supabase prod project (the only environment in v1 — no staging).
SUPABASE_PROD_URL=
SUPABASE_PROD_SERVICE_ROLE_KEY=
SUPABASE_PROD_DB_PASSWORD=

# Vercel — project-level deploys + env var management via API.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# GitHub — org-level operations (repo secrets, automation).
GITHUB_ORG=
GITHUB_ORG_ADMIN_TOKEN=

# GitHub OAuth App used for Supabase Auth "Sign in with GitHub".
# Created at https://github.com/organizations/<org>/settings/applications/new
# See docs/handbook/auth-github-sso.md. Consumed by:
#   scripts/configure-supabase-github-provider.sh
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_CLIENT_SECRET=

# Override the target Supabase project (defaults to vaubaan core prod).
SUPABASE_PROJECT_REF=

# ── Email approval channel (Phase 6) ───────────────────────────────────────
# Resend API key (re_*). Falls back to SMTP_PASS when omitted (Resend SMTP).
RESEND_API_KEY=
# From: header used by EmailChannel. Falls back to SMTP_FROM.
EMAIL_FROM_ADDRESS=
# HMAC-SHA-256 secret used to sign the approve/deny links sent by email.
# Generate with: openssl rand -hex 32. Rotate periodically — old links expire instantly.
EMAIL_SIGNING_SECRET=
# Public base URL of the gateway (no trailing slash). Falls back to NEXT_PUBLIC_APP_URL.
APPROVAL_LINK_BASE_URL=
